{
  "manifest_version": 3,
  "name": "Kollect",
  "version": "1.0.0",
  "description": "Send the addresses of your open tabs, or the links in highlighted text, to Kollect and copy them to the clipboard.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging", "clipboardWrite", "contextMenus", "scripting", "activeTab"],
  "action": {
    "default_title": "Send tabs to Kollect",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/kollect-16.png", "32": "icons/kollect-32.png", "48": "icons/kollect-48.png"}
  },
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/kollect-16.png", "32": "icons/kollect-32.png", "48": "icons/kollect-48.png",
            "128": "icons/kollect-128.png"}
}
